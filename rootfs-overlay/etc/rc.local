#!/bin/sh
# Last-resort network bootstrap for ZTE F673AV9a.
# netifd may fail to bring up the interface if the expected device name
# differs, so force the management address onto whichever ethernet port
# actually exists. Harmless when netifd already configured it.

for d in /sys/class/net/*; do
	n=$(basename "$d")
	case "$n" in
		lo|br-*|wlan*|sit*|tun*|ip6*|gre*|bond*) continue ;;
	esac
	ip link set "$n" up 2>/dev/null
done

for cand in eth0 eth1 eth2 eth3 lan lan1; do
	if [ -d "/sys/class/net/$cand" ]; then
		ip addr add 192.168.1.1/24 dev "$cand" 2>/dev/null
		break
	fi
done

exit 0
