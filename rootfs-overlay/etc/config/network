config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd00:f673:a9a9::/48'

# Vendor kernel 4.19 has NO bridge module built in and our rootfs only ships
# 6.12 modules, so br-lan cannot be created. Bind the static address straight
# onto eth0 (the port u-boot uses for TFTP, i.e. LAN1).
config interface 'lan'
	option device 'eth0'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
