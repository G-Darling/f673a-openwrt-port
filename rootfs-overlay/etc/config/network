config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

# ZTE F673AV9a / ZX279128S: the vendor kernel exposes the LAN port as mii0
# (see the factory /etc/sysconfig/network-scripts/ifcfg-mii0). There is no
# bridge module and the vendor kernel OOPSes (then watchdog-resets the board)
# if eth0 is ever opened, so the management address is bound straight to mii0.
config interface 'lan'
	option device 'mii0'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
