#!/bin/sh
# Bring-up init v9d for the ZTE F673A (vendor 4.19.136 kernel, no console).
#
# v9d = bisect step 4: bspdriver ONLY (no netdriver), insmod only.
# Rationale: v9b (bspdriver+netdriver, full bring-up) reset-loops; v8 (no
# modules) is stable. This run separates "insmod panics" from "bring-up
# (ip link up/ifconfig/ping) panics":
#   - stable here  -> panic is in the bring-up path (link event / PHY ioctls)
#   - still loops  -> netdriver (or bspdriver) insmod itself panics
#
# HARD RULE kept from v8: NEVER write to NAND. Everything to tmpfs.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /tmp /var /var/run /var/log /root 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /var/run 2>/dev/null

: > /tmp/boot.log

for m in bspdriver; do
	if /sbin/insmod /kmodule/$m.ko 2>>/tmp/boot.log; then
		echo "[V9D] insmod $m OK" >> /tmp/boot.log
	else
		echo "[V9D] insmod $m FAILED" >> /tmp/boot.log
	fi
	sleep 1
done

# just observe, do NOT touch the interfaces
sleep 10
echo "[V9D] netdevs: $(ls /sys/class/net 2>/dev/null | tr '\n' ',')" >> /tmp/boot.log

telnetd -l /bin/sh -p 23 >/dev/null 2>&1 &
echo "[V9D] telnetd up" >> /tmp/boot.log

exec sleep 100000000
