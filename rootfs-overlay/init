#!/bin/sh
# Bring-up init v16 for the ZTE F673AV9a (vendor 4.19 kernel, no console).
#
# UNIFIED EXPLANATION of v11..v15 symptoms (ping OK, every port refused,
# board stable):
#   1. OpenWrt busybox nc is CLIENT-ONLY (usage "nc [IPADDR PORT]", no -l/-p/-e)
#      -> all nc "listeners" (5555 log dump, 23 shell) were no-ops
#   2. telnetd applet absent from busybox
#   3. dropbear 2025.89 with baked OpenSSH keys still failed to start
#      (reason invisible: no working remote log channel)
#   4. v12: foreground dropbearkey hung -> PID1 wedged after IP assignment
# Fix in v16: /usr/sbin/netshell - a no-libc static ARM TCP shell server
# (raw syscalls, fork+execve /bin/sh, listens on 23). Nothing external
# needed; busybox sh is known to work on the board (ip/ping/ifconfig ran).
# eth* must NOT be opened on the vendor kernel (OOPS + watchdog reset).
#
# Remote access after boot (PC = 192.168.1.254):
#   nc 192.168.1.1 23   -> busybox shell (primary now)
#   ssh root@192.168.1.1 (pw f673a2026) if dropbear starts
# Boot log: cat /tmp/boot.log once connected.
#
# HARD RULE: NEVER write to NAND. Root stays read-only.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /tmp /var /var/run /var/log /root 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /var/run 2>/dev/null

L=/tmp/boot.log
: > "$L"
log() {
	echo "[V16] $(cut -d' ' -f1 /proc/uptime 2>/dev/null) $1" >> "$L"
}

log "start"
log "ver $(cat /proc/version 2>/dev/null)"
log "cmdline: $(cat /proc/cmdline 2>/dev/null)"
log "netdevs: $(ls /sys/class/net 2>/dev/null | tr '\n' ' ')"
log "mtd: $(cut -d' ' -f1,3,4 /proc/mtd 2>/dev/null | tr '\n' ' ')"
log "urandom: $(ls -l /dev/urandom 2>&1 | head -1)"
log "dropbear keys: $(ls /etc/dropbear/ 2>&1 | tr '\n' ' ')"

# ---- UART beacon: background only, never wedge PID1 -----------------------
(
	for t in /dev/ttyS0 /dev/ttyAMA0 /dev/ttyS1 /dev/ttyPS0; do
		[ -c "$t" ] || continue
		timeout 3 stty -F "$t" 115200 raw -echo >/dev/null 2>&1 || continue
		timeout 3 sh -c "printf '\r\n[V16] alive on $t\r\n' > $t" >/dev/null 2>&1 || continue
		echo "$t" > /tmp/uart_beacon_dev
		break
	done
) </dev/null &

# ---- netshell: no-libc static TCP shell server on 23 ----------------------
if [ -x /usr/sbin/netshell ]; then
	/usr/sbin/netshell </dev/null >>"$L" 2>&1 &
	log "netshell started on 23"
else
	log "netshell MISSING"
fi

# ---- dropbear on 22 (baked OpenSSH keys; stderr into boot.log) ------------
BKEYS=""
for k in /etc/dropbear/dropbear_ed25519_host_key \
         /etc/dropbear/dropbear_rsa_host_key; do
	[ -s "$k" ] && BKEYS="$BKEYS -r $k"
done
if [ -n "$BKEYS" ]; then
	/usr/sbin/dropbear -p 22 $BKEYS </dev/null >>"$L" 2>&1 &&
		log "dropbear 22 started (baked keys)" ||
		log "dropbear baked-keys start FAILED rc=$?"
fi

# fallback: runtime keygen, timeout-guarded, background
if ! pidof dropbear >/dev/null 2>&1; then
	(
		timeout 60 dropbearkey -t ed25519 -f /tmp/dk_ed25519 </dev/null >/tmp/dk_ed.err 2>&1
		timeout 60 dropbearkey -t rsa -s 2048 -f /tmp/dk_rsa </dev/null >/tmp/dk_rsa.err 2>&1
		F=""
		[ -s /tmp/dk_ed25519 ] && F="$F -r /tmp/dk_ed25519"
		[ -s /tmp/dk_rsa ] && F="$F -r /tmp/dk_rsa"
		[ -n "$F" ] && /usr/sbin/dropbear -p 22 $F </dev/null >>"$L" 2>&1
		echo done > /tmp/fb_done
	) </dev/null &
	log "fallback keygen dispatched (background)"
fi

# ---- netdev bring-up (timeout-guarded; NEVER touch eth*) ------------------
ip link set lo up 2>/dev/null

for n in /sys/class/net/*; do
	d=${n##*/}
	[ "$d" = "lo" ] && continue
	case "$d" in
	eth*) log "SKIP $d (opening eth* OOPSes the vendor kernel)"; continue ;;
	esac
	log "PRE $d"
	timeout 8 ip link set "$d" up >/dev/null 2>&1 ||
		log "LINK-UP $d: timeout/fail"
	sleep 2
	log "UP $d st=$(cat /sys/class/net/$d/operstate 2>/dev/null)"
	timeout 5 ifconfig "$d" 192.168.1.1 netmask 255.255.255.0 >/dev/null 2>&1 ||
		timeout 5 ip addr add 192.168.1.1/24 dev "$d" >/dev/null 2>&1 ||
		log "ADDR $d: timeout/fail"
	ping -c 1 -W 1 192.168.1.254 >/dev/null 2>&1 && log "PING-OK $d"
	sleep 1
done

# ---- stay alive ----------------------------------------------------------
(while :; do ping -c 1 -W 2 192.168.1.254 >/dev/null 2>&1; sleep 10; done) </dev/null &

LINKED=""
i=0
while [ $i -lt 30 ]; do
	for n in /sys/class/net/*; do
		d=${n##*/}
		[ "$d" = "lo" ] && continue
		case "$d" in eth*) continue ;; esac
		[ "$(cat /sys/class/net/$d/operstate 2>/dev/null)" = "up" ] && LINKED="$LINKED $d"
	done
	[ -n "$LINKED" ] && break
	sleep 3
	i=$((i + 1))
done
log "LINKED=$LINKED"
log "staying alive - nc 192.168.1.1 23 for shell, cat /tmp/boot.log"

exec sleep 100000000
