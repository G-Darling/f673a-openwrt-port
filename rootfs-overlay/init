#!/bin/sh
# Bring-up init v5 for the ZTE F673AV9a (no usable kernel console).
#
# v4's NAND marker writes silently failed: the dd seek was computed from the
# ABSOLUTE flash address (0x59E0000/512) instead of the offset INSIDE the
# rootfs2 partition (which starts at 0x3A00000). seek=65536 lands past the end
# of the 32 MB partition, so every dd failed and the scratch stayed 0xFF.
#
# v5 fixes the offsets and additionally logs /proc/mtd.
#
#   scratch = last erase block of the rootfs2 partition
#      part-offset 0x1FE0000 (abs 0x59E0000)  : stage log
#      part-offset 0x1FE8000 (abs 0x59E8000)  : kernel dmesg (tail, 30 KB)
#
# Readable from u-boot:
#   nand read 0x52000000 0x59E0000 0x20000 ; md.b 0x52000000 0x800

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

PART_START=0x3A00000        # rootfs2 partition base, absolute
SCRATCH_OFF=$((0x1FE0000))  # offset inside the partition
DMESG_OFF=$((0x1FE8000))
SCRATCH_BLK=$((SCRATCH_OFF / 512))   # 65280
DMESG_BLK=$((DMESG_OFF / 512))       # 65344

UART=""
STAGE=/tmp/stage

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /tmp /var /var/run /var/log /root /etc/dropbear
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /run 2>/dev/null
mount -t tmpfs tmpfs /var/run 2>/dev/null
mount -o remount,rw / 2>/dev/null

# locate rootfs2 dynamically instead of hardcoding mtd13
MTDN=$(sed -n 's/^mtd\([0-9][0-9]*\):.*rootfs2.*/\1/p' /proc/mtd 2>/dev/null | head -n 1)
[ -n "$MTDN" ] || MTDN=13
DEV=/dev/mtdblock$MTDN
[ -e "$DEV" ] || mknod "$DEV" b 31 "$MTDN" 2>/dev/null

for t in /dev/ttyS0 /dev/ttyAMA0 /dev/ttyS1 /dev/ttyPS0; do
	[ -c "$t" ] || continue
	stty -F "$t" 115200 raw -echo 2>/dev/null
	if printf '\r\n[OW5] alive on %s\r\n' "$t" > "$t" 2>/dev/null; then
		UART="$t"
		break
	fi
done

pad512() {
	while [ $(( $(wc -c < "$1") % 512 )) -ne 0 ]; do
		echo >> "$1"
	done
}

flush_stage() {
	pad512 "$STAGE"
	dd if="$STAGE" of="$DEV" bs=512 seek=$SCRATCH_BLK conv=notrunc 2>/dev/null
	sync
}

flush_dmesg() {
	dmesg 2>/dev/null | tail -c 30000 > /tmp/dm
	pad512 /tmp/dm
	dd if=/tmp/dm of="$DEV" bs=512 seek=$DMESG_BLK conv=notrunc 2>/dev/null
	sync
}

mark() {
	echo "$1" >> "$STAGE" 2>/dev/null
	[ -n "$UART" ] && printf '[OW5] %s\r\n' "$1" > "$UART" 2>/dev/null
	flush_stage
}

mark "M1 mounted mtddev=$DEV"
mark "mtdmap $(cat /proc/mtd 2>/dev/null | tr '\n' '|')"

flush_dmesg
mark "M2 dmesg=$(wc -c < /tmp/dm 2>/dev/null)"

mark "M3 net=$(ls /sys/class/net 2>/dev/null | tr '\n' ',')"

# one interface at a time: the marker before the fatal one is the culprit
for n in /sys/class/net/*; do
	d=${n##*/}
	[ "$d" = "lo" ] && continue
	[ "$d" = "eth0" ] && continue
	mark "PRE $d"
	ip link set "$d" up 2>/dev/null || ifconfig "$d" up 2>/dev/null
	ifconfig "$d" 192.168.1.1 netmask 255.255.255.0 up 2>/dev/null
	ip addr add 192.168.1.1/24 dev "$d" 2>/dev/null
	sleep 1
	mark "POST $d state=$(cat /sys/class/net/$d/operstate 2>/dev/null) addr=$(ip -4 addr show "$d" 2>/dev/null | grep -o 192.168.1.1 | head -n1)"
done

# eth0 last: this is the one suspected of crashing the kernel
if [ -e /sys/class/net/eth0 ]; then
	mark "PRE eth0 (last, suspected crash)"
	ip link set eth0 up 2>/dev/null || ifconfig eth0 up 2>/dev/null
	sleep 1
	mark "POST eth0 state=$(cat /sys/class/net/eth0/operstate 2>/dev/null)"
else
	mark "no eth0"
fi

mark "NET DONE"

/usr/sbin/dropbear -R -p 22 -P /tmp/dropbear.pid >> /tmp/stage 2>&1
[ -f /tmp/dropbear.pid ] && mark "dropbear up"
telnetd -l /bin/sh -p 23 > /dev/null 2>&1 &
sleep 1
mark "telnetd 23"

flush_dmesg
mark "READY"

exec /bin/sleep 100000000
