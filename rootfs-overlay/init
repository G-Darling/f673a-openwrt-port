#!/bin/sh
# Bring-up init v13 for the ZTE F673AV9a (vendor 4.19 kernel, no console).
#
# v12 finding (2026-11-27): board stable, ping OK, but ALL server ports
# refused -> init hung somewhere between bring-up and the nc loops.
# Prime suspect: `dropbearkey` blocking (first command after bring-up).
# Fix strategy:
#   1. start the nc:5555 boot.log dump server FIRST (remote diagnosis channel)
#   2. host keys are PRE-BAKED in the image at CI build time (OpenSSH format,
#      dropbear >=2020.79 reads them) -> no runtime keygen needed
#   3. keygen only as fallback, wrapped in `timeout 60` (busybox timeout)
#
# Remote access after boot (PC = 192.168.1.254):
#   ssh root@192.168.1.1   (password f673a2026)  <- primary
#   nc 192.168.1.1 23      (busybox nc shell fallback, if -e supported)
#   nc 192.168.1.1 5555    (one-shot dump of /tmp/boot.log)
#
# HARD RULE: NEVER write to NAND. Root stays read-only; keys live in
# /etc/dropbear (read-only use) or /tmp (fallback), never elsewhere.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /tmp /var /var/run /var/log /root 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /var/run 2>/dev/null

# best-effort uart beacon (kernel console is dead; harmless)
for t in /dev/ttyS0 /dev/ttyAMA0 /dev/ttyS1 /dev/ttyPS0; do
	[ -c "$t" ] || continue
	stty -F "$t" 115200 raw -echo 2>/dev/null
	if printf '\r\n[V13] alive on %s\r\n' "$t" > "$t" 2>/dev/null; then
		UART="$t"
		break
	fi
done

L=/tmp/boot.log
: > "$L"
log() {
	echo "[V13] $(cut -d' ' -f1 /proc/uptime 2>/dev/null) $1" >> "$L"
	[ -n "$UART" ] && printf '[V13] %s\r\n' "$1" > "$UART" 2>/dev/null
}

log "start"
log "ver $(cat /proc/version 2>/dev/null)"
log "cmdline: $(cat /proc/cmdline 2>/dev/null)"
log "netdevs: $(ls /sys/class/net 2>/dev/null | tr '\n' ' ')"
log "mtd: $(cut -d' ' -f1,3,4 /proc/mtd 2>/dev/null | tr '\n' ' ')"

ip link set lo up 2>/dev/null

# bring up every netdev, assign 192.168.1.1, probe the host with ping
for n in /sys/class/net/*; do
	d=${n##*/}
	[ "$d" = "lo" ] && continue
	log "PRE $d"
	ip link set "$d" up 2>/dev/null || ifconfig "$d" up 2>/dev/null
	sleep 2
	log "UP $d st=$(cat /sys/class/net/$d/operstate 2>/dev/null)"
	ifconfig "$d" 192.168.1.1 netmask 255.255.255.0 2>/dev/null ||
		ip addr add 192.168.1.1/24 dev "$d" 2>/dev/null
	ping -c 2 -W 2 192.168.1.254 >/dev/null 2>&1 && log "PING-OK $d"
	sleep 1
done

# ---- remote diagnosis channel FIRST (before anything that can hang) ------
# one-shot dump of boot.log per connection; a while-loop keeps serving.
(while :; do nc -l -p 5555 < "$L" >/dev/null 2>&1; sleep 1; done) </dev/null &
log "nc log dump on 5555 started"

# ---- dropbear on 22 ------------------------------------------------------
# primary: pre-baked OpenSSH-format keys inside the image (read-only use)
BKEYS=""
for k in /etc/dropbear/dropbear_ed25519_host_key \
         /etc/dropbear/dropbear_rsa_host_key; do
	[ -s "$k" ] && BKEYS="$BKEYS -r $k"
done
if [ -n "$BKEYS" ]; then
	log "baked keys present"
	/usr/sbin/dropbear -p 22 $BKEYS </dev/null >>"$L" 2>&1 &&
		log "dropbear 22 started (baked keys)" ||
		log "dropbear with baked keys FAILED rc=$?"
fi

# fallback: runtime keygen, timeout-guarded, only if dropbear is not up
if ! pidof dropbear >/dev/null 2>&1; then
	log "fallback keygen (timeout 60 each)"
	(
		timeout 60 dropbearkey -t ed25519 -f /tmp/dk_ed25519 </dev/null >/dev/null 2>&1
		timeout 60 dropbearkey -t rsa -s 2048 -f /tmp/dk_rsa </dev/null >/dev/null 2>&1
		F=""
		[ -s /tmp/dk_ed25519 ] && F="$F -r /tmp/dk_ed25519"
		[ -s /tmp/dk_rsa ] && F="$F -r /tmp/dk_rsa"
		[ -n "$F" ] && /usr/sbin/dropbear -p 22 $F </dev/null >/tmp/dbr.err 2>&1
		echo done > /tmp/fb_done
	) </dev/null &
fi

# ---- shell fallback via busybox nc ---------------------------------------
if nc --help 2>&1 | grep -q -- '-e'; then
	(while :; do nc -l -p 23 -e /bin/sh >/dev/null 2>&1; sleep 1; done) </dev/null &
	log "nc shell fallback on 23"
else
	log "nc has no -e, shell fallback skipped"
fi

# ---- stay alive ----------------------------------------------------------
(while :; do ping -c 1 -W 2 192.168.1.254 >/dev/null 2>&1; sleep 10; done) </dev/null &

LINKED=""
i=0
while [ $i -lt 30 ]; do
	for n in /sys/class/net/*; do
		d=${n##*/}
		[ "$d" = "lo" ] && continue
		[ "$(cat /sys/class/net/$d/operstate 2>/dev/null)" = "up" ] && LINKED="$LINKED $d"
	done
	[ -n "$LINKED" ] && break
	sleep 3
	i=$((i + 1))
done
log "LINKED=$LINKED"
log "staying alive - ssh root@192.168.1.1 (pw f673a2026), nc 5555 for boot.log"

exec sleep 100000000
