#!/bin/sh
# Bring-up init v22 for the ZTE F673AV9a (vendor 4.19 kernel, no console).
#
# v21 board-test results (2026-11-27, __log_buf mining of initbin v10):
#   * FULL [V21] sequence landed: watchdog probe path=proc_ctrl, mounts
#     done, start net=ip6tnl0,lo,pon0,sit0, PRE/UP for each netdev,
#     telnetd/netshell/dropbear attempted, liveness loop alive 0-120s.
#   * **NO ETHERNET NIC IN KERNEL**: /sys/class/net only has virtual
#     interfaces (ip6tnl0, lo, pon0, sit0). The onboard 2.5GbE driver is
#     a LOADABLE MODULE in vendor land, not built-in.
#   * Kernel strings reveal the mechanism: "/kmoduletmp/kmodule.img",
#     "open kmodule.img failed!", "mount loop0" - vendor kernel mounts a
#     kmodule.img (loop) holding all .ko files.
#   * Our root is mtd13 (31:13) => mtd12 "rootfs1" likely still holds the
#     ORIGINAL vendor rootfs; osgi1/osgi2 hold vendor app fs. Vendor
#     kernel natively supports those filesystems.
#
# v22 changes vs v21:
#   * mount vendor partitions (mtdblock12 rootfs1, mtdblock9 osgi1),
#     find kmodule.img, loop-mount it, insmod ALL .ko (klog failures),
#     then re-list /sys/class/net - the ethernet hunt in one shot.
#   * no exec-with-device-redirect (v21 lesson), klog spaced 1s (v21)
#   * HARD RULE unchanged: never write NAND, keep root read-only

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

# ---------- kmsg channel first (initbin already created /dev/kmsg) ----------
[ -e /dev/kmsg ] || mknod /dev/kmsg c 1 11 2>/dev/null
[ -c /dev/kmsg ] && exec 2>/dev/kmsg

klog() {
	printf '[V22] %s\n' "$1" > /dev/kmsg 2>/dev/null
	printf '[V22] %s\n' "$1" > /tmp/v22.log 2>/dev/null
	sleep 1
}

# ---------- mounts FIRST (feed fallback needs /proc) ----------
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /tmp /var /var/run /var/log /root 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /var/run 2>/dev/null

# ---------- watchdog: per-feed single writes, no fd keeping ----------
WOPEN=no
WDNODE=no
[ -e /dev/watchdog ] || mknod /dev/watchdog c 10 130 2>/dev/null
[ -c /dev/watchdog ] && WDNODE=yes

feed() {
	if [ "$WDNODE" = "yes" ] && printf 'F' > /dev/watchdog 2>/dev/null; then
		return 0
	fi
	printf 'feeddog' > /proc/watchdog/ctrl 2>/dev/null && return 0
	printf 'feeddog' > /proc/watchdog 2>/dev/null && return 0
	return 1
}

WDPATH=none
if [ "$WDNODE" = "yes" ] && printf 'F' > /dev/watchdog 2>/dev/null; then
	WDPATH=node
elif printf 'feeddog' > /proc/watchdog/ctrl 2>/dev/null; then
	WDPATH=proc_ctrl
elif printf 'feeddog' > /proc/watchdog 2>/dev/null; then
	WDPATH=proc_root
fi
klog "watchdog probe path=$WDPATH"

# background feeder: survives even if main flow stalls
(
	while :; do
		feed 2>/dev/null
		sleep 3
	done
) &

klog "mounts done mtd=$(cut -d' ' -f1,3,4 /proc/mtd 2>/dev/null | tr '\n' '|')"

# ---------- ethernet hunt: vendor rootfs -> kmodule.img -> insmod ----------
mkdir -p /mnt/a /mnt/b /mnt/c /mnt/kmod

# mtdblock nodes (devtmpfs usually makes them; mknod fallback major 31)
for i in 9 10 12 13; do
	[ -b /dev/mtdblock$i ] || mknod /dev/mtdblock$i b 31 $i 2>/dev/null
done

mount_one() { # <mtdblock> <mnt> : try jffs2 then squashfs
	mount -t jffs2 "/dev/mtdblock$1" "$2" 2>/dev/null && return 0
	mount -t squashfs "/dev/mtdblock$1" "$2" 2>/dev/null && return 0
	mount -t cramfs "/dev/mtdblock$1" "$2" 2>/dev/null && return 0
	return 1
}

VSRC=""
mount_one 12 /mnt/a && VSRC=mtd12 || klog "mtd12 mount failed"
[ -n "$VSRC" ] || { mount_one 9 /mnt/a && VSRC=mtd9 || klog "mtd9 mount failed"; }
[ -n "$VSRC" ] || { mount_one 10 /mnt/a && VSRC=mtd10 || klog "mtd10 mount failed"; }
klog "vendor fs src=$VSRC"

KMI=""
if [ -n "$VSRC" ]; then
	find /mnt/a -maxdepth 4 -name 'kmodule*.img' > /tmp/kmi 2>/dev/null
	KMI=$(head -1 /tmp/kmi 2>/dev/null)
	klog "kmodule.img=[$KMI] toplevel=$(ls /mnt/a 2>/dev/null | tr '\n' ',')"
fi

KMNTED=0
KOUNT=$(find /mnt/kmod -name '*.ko' 2>/dev/null | wc -l)
if [ -n "$KMI" ] && [ "$KOUNT" = "0" ]; then
	if mount -o loop -t squashfs "$KMI" /mnt/kmod 2>/dev/null; then
		KMNTED=1
	elif mount -o loop -t cramfs "$KMI" /mnt/kmod 2>/dev/null; then
		KMNTED=1
	elif mount -o loop -t jffs2 "$KMI" /mnt/kmod 2>/dev/null; then
		KMNTED=1
	fi
	klog "kmodule.img mount rc=$KMNTED"
fi

KOUNT=$(find /mnt/kmod -name '*.ko' 2>/dev/null | wc -l)
klog "ko count=$KOUNT"

if [ "$KOUNT" != "0" ]; then
	# insmod ALL vendor modules in find order (vendor kloader does the
	# same); log only failures to stay inside the kmsg budget
	FAILS=""
	for f in $(find /mnt/kmod -name '*.ko' 2>/dev/null); do
		insmod "$f" 2>/dev/null || FAILS="$FAILS ${f##*/}"
	done
	klog "insmod fails=[$FAILS]"
fi

klog "after-insmod net=$(ls /sys/class/net 2>/dev/null | tr '\n' ',')"

# ---------- bring up whatever appeared (eth/mii candidates) ----------
ip link set lo up 2>/dev/null
for n in /sys/class/net/*; do
	d=${n##*/}
	[ "$d" = "lo" ] && continue
	klog "PRE $d"
	ip link set "$d" up 2>/dev/null || ifconfig "$d" up 2>/dev/null
	sleep 2
	klog "UP $d st=$(cat /sys/class/net/$d/operstate 2>/dev/null)"
	ifconfig "$d" 192.168.1.1 netmask 255.255.255.0 2>/dev/null ||
		ip addr add 192.168.1.1/24 dev "$d" 2>/dev/null
	ping -c 2 -W 2 192.168.1.254 >/dev/null 2>&1 && klog "PING-OK $d"
done

# ---------- remote access attempts (stderr already -> kmsg) ----------
telnetd -l /bin/sh -p 23 >/dev/null 2>&1 &
klog "telnetd attempted"

/usr/sbin/netshell >/dev/null 2>&1 &
klog "netshell attempted on :23"

mkdir -p /etc/dropbear 2>/dev/null
dropbear -F -E -p 22 >/dev/null 2>&1 &
klog "dropbear attempted on :22"

# ---------- liveness loop: PID1 NEVER exits ----------
LINKED=""
i=0
while :; do
	for n in /sys/class/net/*; do
		d=${n##*/}
		[ "$d" = "lo" ] && continue
		[ "$(cat /sys/class/net/$d/operstate 2>/dev/null)" = "up" ] &&
			LINKED="$LINKED $d"
	done
	feed 2>/dev/null || klog "watchdog feed FAILED in main loop"
	if [ $((i % 10)) -eq 0 ]; then
		klog "alive t=$((i * 3))s linked=[$LINKED] up=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)"
	fi
	i=$((i + 1))
	sleep 3
done
