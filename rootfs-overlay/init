#!/bin/sh
# Bring-up init v7 for the ZTE F673AV9a (no usable kernel console).
#
# v5/v6 reset-looped with NO markers at all. Ladder evidence:
#   v4: dd to mtdblock13 BEYOND end-of-device -> fails harmlessly -> STABLE
#   v5: dd to mtdblock13 at a VALID offset    -> reset loop (~13s)
#   v6: dd to mtdblock12 at a VALID offset    -> reset loop (~13s)
# => any real write through the mtdblock CACHE layer panics this kernel.
#
# v7 writes markers through the mtd CHAR device instead, using the static
# /usr/sbin/nandmark tool (MEMERASE + pwrite) - the same path jffs2 uses.
#
#   rootfs1 (mtd "rootfs1", not mounted):
#      part 0x1FE0000 (abs 0x39E0000) : stage log (each mark re-erases+writes)
#      part 0x1FE8000 (abs 0x39E8000) : kernel dmesg (tail, 30 KB)
#   Read from u-boot: nand read 0x52000000 0x39e0000 0x20000
#
# One probe write to the MOUNTED rootfs2 (char device) is bracketed by
# markers so a panic there names itself.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

NM=/usr/sbin/nandmark
SCRATCH=1FE0000
DMESG_OFF=1FE8000
STAGE=/tmp/stage
DMF=/tmp/dm

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /tmp /var /var/run /var/log /root /etc/dropbear
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /run 2>/dev/null
mount -t tmpfs tmpfs /var/run 2>/dev/null
mount -o remount,rw / 2>/dev/null

MTDA=$(sed -n 's/^mtd\([0-9][0-9]*\):.*rootfs1.*/\1/p' /proc/mtd 2>/dev/null | head -n 1)
[ -n "$MTDA" ] || MTDA=12
DEVA=/dev/mtd$MTDA
[ -e "$DEVA" ] || mknod "$DEVA" c 90 $((MTDA * 2)) 2>/dev/null
MTDB=$(sed -n 's/^mtd\([0-9][0-9]*\):.*rootfs2.*/\1/p' /proc/mtd 2>/dev/null | head -n 1)
[ -n "$MTDB" ] || MTDB=13
DEVB=/dev/mtd$MTDB

for t in /dev/ttyS0 /dev/ttyAMA0 /dev/ttyS1 /dev/ttyPS0; do
	[ -c "$t" ] || continue
	stty -F "$t" 115200 raw -echo 2>/dev/null
	if printf '\r\n[OW7] alive on %s\r\n' "$t" > "$t" 2>/dev/null; then
		UART="$t"
		break
	fi
done

: > "$STAGE"
RCLAST=none

mark() {
	echo "rc=$RCLAST" >> "$STAGE"
	echo "$1" >> "$STAGE"
	[ -n "$UART" ] && printf '[OW7] %s\r\n' "$1" > "$UART" 2>/dev/null
	RCLAST=$("$NM" "$DEVA" "$STAGE" "$SCRATCH" 2>&1 | tail -n 1)
}

markdm() {
	dmesg 2>/dev/null | tail -c 30000 > "$DMF"
	mark "$1"
	"$NM" "$DEVA" "$DMF" "$DMESG_OFF" > /dev/null 2>&1
}

markdm "M0 alive nm=$([ -x $NM ] && echo yes || echo NO) a=$DEVA b=$DEVB"
mark "mtdmap $(cat /proc/mtd 2>/dev/null | tr '\n' '|')"

# THE experiment: one probe write to the mounted rootfs2, via char device
mark "TEST-B begin nandmark->$DEVB @$SCRATCH"
"$NM" "$DEVB" "$STAGE" "$SCRATCH" > /tmp/tb 2>&1
echo "TEST-B probe rc: $(cat /tmp/tb 2>/dev/null)" >> "$STAGE"
mark "TEST-B done (char-dev write to mounted root survived)"

mark "M3 net=$(ls /sys/class/net 2>/dev/null | tr '\n' ',')"

# one interface at a time: the marker before the fatal one is the culprit
for n in /sys/class/net/*; do
	d=${n##*/}
	[ "$d" = "lo" ] && continue
	[ "$d" = "eth0" ] && continue
	mark "PRE $d"
	ip link set "$d" up 2>/dev/null || ifconfig "$d" up 2>/dev/null
	ifconfig "$d" 192.168.1.1 netmask 255.255.255.0 up 2>/dev/null
	ip addr add 192.168.1.1/24 dev "$d" 2>/dev/null
	sleep 1
	mark "POST $d state=$(cat /sys/class/net/$d/operstate 2>/dev/null)"
done

# eth0 last: this is the one suspected of crashing the kernel
if [ -e /sys/class/net/eth0 ]; then
	mark "PRE eth0 (last, suspected crash)"
	ip link set eth0 up 2>/dev/null || ifconfig eth0 up 2>/dev/null
	sleep 1
	mark "POST eth0 state=$(cat /sys/class/net/eth0/operstate 2>/dev/null)"
else
	mark "no eth0"
fi

mark "NET DONE"

/usr/sbin/dropbear -R -p 22 -P /tmp/dropbear.pid >> /tmp/stage 2>&1
[ -f /tmp/dropbear.pid ] && mark "dropbear up"
telnetd -l /bin/sh -p 23 > /dev/null 2>&1 &
sleep 1
mark "telnetd 23"

markdm "READY"

exec /bin/sleep 100000000
