#!/bin/sh
# Bring-up init v4 for the ZTE F673AV9a (no usable kernel console).
#
# v3 brought up every netdev and the board went into a reset loop, so one of
# the interfaces kills the kernel. Since there is no console, this version
# persists evidence to a scratch NAND block instead:
#
#   scratch = last erase block of the rootfs2 partition (abs 0x59E0000)
#      +0x0000 : stage log   ("M1 mounted", "PRE eth0", ...)
#      +0x8000 : kernel dmesg (tail, 30 KB)
#
# Both are readable from u-boot with:
#   nand read 0x52000000 0x59E0000 0x20000 ; md.b 0x52000000 0x100
#
# Network is brought up one interface at a time with a marker before and after,
# so whatever kills the kernel is identified by the last marker written.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

SCRATCH_BLK=65536          # 0x59E0000 / 512
DMESG_BLK=65600            # 0x59E8000 / 512
DEV=/dev/mtdblock13

UART=""
STAGE=/tmp/stage

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /tmp /var /var/run /var/log /root /etc/dropbear
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /run 2>/dev/null
mount -t tmpfs tmpfs /var/run 2>/dev/null
mount -o remount,rw / 2>/dev/null

for t in /dev/ttyS0 /dev/ttyAMA0 /dev/ttyS1 /dev/ttyPS0; do
	[ -c "$t" ] || continue
	stty -F "$t" 115200 raw -echo 2>/dev/null
	if printf '\r\n[OW4] alive on %s\r\n' "$t" > "$t" 2>/dev/null; then
		UART="$t"
		break
	fi
done

[ -e "$DEV" ] || mknod "$DEV" b 31 13 2>/dev/null

flush_stage() {
	dd if="$STAGE" of="$DEV" bs=512 seek=$SCRATCH_BLK conv=notrunc 2>/dev/null
	sync
}

mark() {
	echo "$1" >> "$STAGE" 2>/dev/null
	[ -n "$UART" ] && printf '[OW4] %s\r\n' "$1" > "$UART" 2>/dev/null
	flush_stage
}

mark "M1 mounted"

# kernel log first: it already contains the netdev/phy probe results
dmesg 2>/dev/null | tail -c 30000 > /tmp/dm
[ -s /tmp/dm ] && dd if=/tmp/dm of="$DEV" bs=512 seek=$DMESG_BLK conv=notrunc 2>/dev/null
sync
mark "M2 dmesg=$(wc -c < /tmp/dm 2>/dev/null)"

mark "M3 net=$(ls /sys/class/net 2>/dev/null | tr '\n' ',')"

# one interface at a time: the marker before the fatal one is the culprit
for n in /sys/class/net/*; do
	d=${n##*/}
	[ "$d" = "lo" ] && continue
	[ "$d" = "eth0" ] && continue
	mark "PRE $d"
	ip link set "$d" up 2>/dev/null || ifconfig "$d" up 2>/dev/null
	ifconfig "$d" 192.168.1.1 netmask 255.255.255.0 up 2>/dev/null
	ip addr add 192.168.1.1/24 dev "$d" 2>/dev/null
	sleep 1
	mark "POST $d state=$(cat /sys/class/net/$d/operstate 2>/dev/null)"
done

# eth0 last: this is the one suspected of crashing the kernel
if [ -e /sys/class/net/eth0 ]; then
	mark "PRE eth0 (last, suspected crash)"
	ip link set eth0 up 2>/dev/null || ifconfig eth0 up 2>/dev/null
	sleep 1
	mark "POST eth0 state=$(cat /sys/class/net/eth0/operstate 2>/dev/null)"
else
	mark "no eth0"
fi

mark "NET DONE"

/usr/sbin/dropbear -R -p 22 -P /tmp/dropbear.pid >> /tmp/stage 2>&1
[ -f /tmp/dropbear.pid ] && mark "dropbear up"
telnetd -l /bin/sh -p 23 > /dev/null 2>&1 &
sleep 1
mark "telnetd 23"

dmesg 2>/dev/null | tail -c 30000 > /tmp/dm
[ -s /tmp/dm ] && dd if=/tmp/dm of="$DEV" bs=512 seek=$DMESG_BLK conv=notrunc 2>/dev/null
mark "READY"

exec /bin/sleep 100000000
