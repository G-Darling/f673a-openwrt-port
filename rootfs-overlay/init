#!/bin/sh
# Bring-up init v12 for the ZTE F673AV9a (vendor 4.19 kernel, no console).
#
# v12 = v11 baseline (verified 2026-11-27) + working remote shell.
# Evidence from the v11 run:
#   * ping 192.168.1.1 stayed UP for 5+ min -> kernel + network stack alive,
#     LINKED path taken, board did NOT reboot
#   * tcp/23 refused -> OpenWrt busybox has NO telnetd applet (verified in
#     bin/busybox: string "telnetd" absent; applet table count 0)
#   * rootfs HAS /usr/sbin/dropbear, /usr/bin/dropbearkey, /usr/bin/nc
# So v12 starts dropbear (password auth, root/f673a2026) instead of telnetd,
# with busybox nc fallbacks.
#
# HARD RULE: NEVER write to NAND.
#   * host keys MUST be generated into /tmp, never /etc/dropbear
#   * all state in tmpfs, root stays read-only
#
# Remote access after boot (PC on 192.168.1.254):
#   ssh root@192.168.1.1        (password f673a2026)   <- primary
#   nc 192.168.1.1 23           (busybox nc shell, if -e supported)
#   nc 192.168.1.1 5555         (dumps /tmp/boot.log, one shot per connect)

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /tmp /var /var/run /var/log /root 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /var/run 2>/dev/null

# best-effort uart beacon (kernel console is dead; harmless)
for t in /dev/ttyS0 /dev/ttyAMA0 /dev/ttyS1 /dev/ttyPS0; do
	[ -c "$t" ] || continue
	stty -F "$t" 115200 raw -echo 2>/dev/null
	if printf '\r\n[V12] alive on %s\r\n' "$t" > "$t" 2>/dev/null; then
		UART="$t"
		break
	fi
done

L=/tmp/boot.log
: > "$L"
log() {
	echo "[V12] $1" >> "$L"
	[ -n "$UART" ] && printf '[V12] %s\r\n' "$1" > "$UART" 2>/dev/null
}

log "start $(date 2>/dev/null)"
log "ver $(cat /proc/version 2>/dev/null)"
log "cmdline: $(cat /proc/cmdline 2>/dev/null)"
log "netdevs: $(ls /sys/class/net 2>/dev/null | tr '\n' ' ')"
log "mtd: $(cut -d' ' -f1,3,4 /proc/mtd 2>/dev/null | tr '\n' ' ')"

ip link set lo up 2>/dev/null

# bring up every netdev, assign 192.168.1.1, probe the host with ping
for n in /sys/class/net/*; do
	d=${n##*/}
	[ "$d" = "lo" ] && continue
	log "PRE $d"
	ip link set "$d" up 2>/dev/null || ifconfig "$d" up 2>/dev/null
	sleep 2
	log "UP $d st=$(cat /sys/class/net/$d/operstate 2>/dev/null)"
	ifconfig "$d" 192.168.1.1 netmask 255.255.255.0 2>/dev/null ||
		ip addr add 192.168.1.1/24 dev "$d" 2>/dev/null
	ping -c 2 -W 2 192.168.1.254 >/dev/null 2>&1 && log "PING-OK $d"
	sleep 1
done

# ---- remote shell servers ------------------------------------------------
# primary: dropbear on 22. Keys in /tmp ONLY (NAND safety rule).
KEY_ED=/tmp/dropbear_ed25519_host_key
KEY_RSA=/tmp/dropbear_rsa_host_key
if dropbearkey -t ed25519 -f "$KEY_ED" >>"$L" 2>&1; then
	log "ed25519 key ok"
else
	rm -f "$KEY_ED"
	log "ed25519 keygen FAILED"
fi
if dropbearkey -t rsa -s 2048 -f "$KEY_RSA" >>"$L" 2>&1; then
	log "rsa key ok"
else
	rm -f "$KEY_RSA"
	log "rsa keygen FAILED"
fi
DBR="/usr/sbin/dropbear -p 22"
[ -s "$KEY_ED" ] && DBR="$DBR -r $KEY_ED"
[ -s "$KEY_RSA" ] && DBR="$DBR -r $KEY_RSA"
if $DBR >>"$L" 2>&1; then
	log "dropbear 22 started"
else
	log "dropbear FAILED (rc=$?)"
fi

# fallback shell + log dump via busybox nc
if nc --help 2>&1 | grep -q -- '-e'; then
	(while :; do nc -l -p 23 -e /bin/sh >/dev/null 2>&1; sleep 1; done) &
	log "nc shell fallback on 23"
else
	log "nc has no -e, shell fallback skipped"
fi
(while :; do nc -l -p 5555 < "$L" >/dev/null 2>&1; sleep 1; done) &
log "nc log dump on 5555"

# ---- stay alive ----------------------------------------------------------
# v11 proved the board is stable; no warm-reboot fallback any more.
# background heartbeat keeps ARP fresh and gives the PC side a liveness probe.
(while :; do ping -c 1 -W 2 192.168.1.254 >/dev/null 2>&1; sleep 10; done) &

LINKED=""
i=0
while [ $i -lt 30 ]; do
	for n in /sys/class/net/*; do
		d=${n##*/}
		[ "$d" = "lo" ] && continue
		[ "$(cat /sys/class/net/$d/operstate 2>/dev/null)" = "up" ] && LINKED="$LINKED $d"
	done
	[ -n "$LINKED" ] && break
	sleep 3
	i=$((i + 1))
done
log "LINKED=$LINKED"
log "staying alive - ssh root@192.168.1.1 (pw f673a2026), nc 5555 for boot.log"

exec sleep 100000000
