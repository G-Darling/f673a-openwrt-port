#!/bin/sh
# Bring-up init v31 for the ZTE F673AV9a (vendor 4.19.136 kernel, no console).
#
# THE BIG FINDING (2026-11-28, local rootfs analysis):
#   * Our OWN rootfs (rf35.tar.gz, flashed to board) already contains
#     /kmodule/*.ko compiled for the RUNNING kernel 4.19.136:
#       patch.ko tm_128s.ko bspdriver.ko switch.ko tun.ko
#       shellproc.ko netdriver.ko      <-- netdriver = ETHERNET!
#     Verified vermagic=4.19.136 SMP mod_unload ARMv7 p2v8 on all 7.
#   * All v23-v30 wasted effort hunting vendor partitions (UBI osgi,
#     osgi.img squashfs, mtd0 jffs2) whose .kos are for kernel 6.12.112
#     -> vermagic MISMATCH -> every insmod failed. Wrong tree entirely.
#   * vendor kernel boot log "zte open kmodule.img failed!" = it tries
#     to load these very drivers from /kmoduletmp/kmodule.img.
#
# v31 changes vs v30:
#   * DROP all UBI/UBIFS/osgi/mtd-block hunting (wrong modules anyway)
#   * insmod /kmodule/*.ko DIRECTLY from our read-only root, in vendor
#     dependency order, multiple passes, each result logged separately
#   * keep: kmsg channel, watchdog feed, network bring-up, dropbear,
#     liveness loop, HARD RULE (never write NAND, keep root read-only)

PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH

# ---------- kmsg channel first (initbin already created /dev/kmsg) ----------
[ -e /dev/kmsg ] || mknod /dev/kmsg c 1 11 2>/dev/null
[ -c /dev/kmsg ] && exec 2>/dev/kmsg

klog() {
	printf '[V31] %s\n' "$1" > /dev/kmsg 2>/dev/null
	printf '[V31] %s\n' "$1" > /tmp/v23.log 2>/dev/null
	sleep 1
}

# ---------- mounts FIRST (feed fallback needs /proc) ----------
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /tmp /var /var/run /var/log /root 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /var/run 2>/dev/null

# ---------- watchdog: per-feed single writes ----------
WDNODE=no
[ -e /dev/watchdog ] || mknod /dev/watchdog c 10 130 2>/dev/null
[ -c /dev/watchdog ] && WDNODE=yes

feed() {
	if [ "$WDNODE" = "yes" ] && printf 'F' > /dev/watchdog 2>/dev/null; then
		return 0
	fi
	printf 'feeddog' > /proc/watchdog/ctrl 2>/dev/null && return 0
	printf 'feeddog' > /proc/watchdog 2>/dev/null && return 0
	return 1
}

WDPATH=none
if [ "$WDNODE" = "yes" ] && printf 'F' > /dev/watchdog 2>/dev/null; then
	WDPATH=node
elif printf 'feeddog' > /proc/watchdog/ctrl 2>/dev/null; then
	WDPATH=proc_ctrl
elif printf 'feeddog' > /proc/watchdog 2>/dev/null; then
	WDPATH=proc_root
fi
klog "watchdog probe path=$WDPATH"

# background feeder: survives even if main flow stalls
(
	while :; do
		feed 2>/dev/null
		sleep 3
	done
) &

# ---------- THE FIX: load OUR OWN 4.19.136 drivers from /kmodule/ ----------
RUNV=$(uname -r 2>/dev/null)
klog "running kernel=$RUNV - loading /kmodule/*.ko (native 4.19 drivers)"
klog "kmodule dir: $(ls /kmodule 2>/dev/null | tr '\n' ',' )"

# vendor dependency order: patch -> tm_128s -> bsp -> switch -> net -> tun -> shellproc
# run several passes: later passes satisfy deps loaded in earlier ones
OKLIST=""
for pass in 1 2 3; do
	for m in patch tm_128s bspdriver switch netdriver tun shellproc; do
		f=/kmodule/$m.ko
		[ -e "$f" ] || continue
		case " $OKLIST " in
			*" $m "*) continue ;;   # already loaded OK
		esac
		if insmod "$f" 2>/dev/null; then
			OKLIST="$OKLIST $m"
			klog "INSMOD OK  $m.ko (pass$pass)"
		else
			klog "INSMOD FAIL $m.ko (pass$pass)"
		fi
	done
done
klog "loaded=[$OKLIST]"

# also try any other .ko in /kmodule (non-standard extras)
for f in /kmodule/*.ko; do
	[ -e "$f" ] || continue
	m=${f##*/}; m=${m%.ko}
	case " $OKLIST " in *" $m "*) continue ;; esac
	if insmod "$f" 2>/dev/null; then
		OKLIST="$OKLIST $m"; klog "INSMOD OK  $m.ko (extra)"
	else
		klog "INSMOD FAIL $m.ko (extra)"
	fi
done

klog "after-insmod net=$(ls /sys/class/net 2>/dev/null | tr '\n' ',')"

# ---------- bring up whatever appeared ----------
ip link set lo up 2>/dev/null
for n in /sys/class/net/*; do
	d=${n##*/}
	[ "$d" = "lo" ] && continue
	klog "PRE $d"
	ip link set "$d" up 2>/dev/null || ifconfig "$d" up 2>/dev/null
	sleep 2
	klog "UP $d st=$(cat /sys/class/net/$d/operstate 2>/dev/null)"
	ifconfig "$d" 192.168.1.1 netmask 255.255.255.0 2>/dev/null ||
		ip addr add 192.168.1.1/24 dev "$d" 2>/dev/null
	ping -c 2 -W 2 192.168.1.254 >/dev/null 2>&1 && klog "PING-OK $d"
done

# ---------- remote access attempts (stderr already -> kmsg) ----------
mkdir -p /etc/dropbear 2>/dev/null
[ -e /etc/dropbear/dropbear_rsa_host_key ] ||
	dropbearkey -t rsa -f /etc/dropbear/dropbear_rsa_host_key >/dev/null 2>&1
dropbear -F -E -p 22 >/dev/null 2>&1 &
klog "dropbear attempted on :22"

/usr/sbin/netshell >/dev/null 2>&1 &
klog "netshell attempted on :23"

# ---------- liveness loop: PID1 NEVER exits ----------
LINKED=""
i=0
while :; do
	for n in /sys/class/net/*; do
		d=${n##*/}
		[ "$d" = "lo" ] && continue
		[ "$(cat /sys/class/net/$d/operstate 2>/dev/null)" = "up" ] &&
			LINKED="$LINKED $d"
	done
	feed 2>/dev/null || klog "watchdog feed FAILED in main loop"
	if [ $((i % 10)) -eq 0 ]; then
		klog "alive t=$((i * 3))s linked=[$LINKED] up=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)"
	fi
	i=$((i + 1))
	sleep 3
done
