#!/bin/sh
# Minimal bring-up init for the ZTE F673AV9a (vendor 4.19 kernel, no console).
#
# Why this exists: OpenWrt's normal /init -> preinit -> procd chain never gets
# the board onto the network here, and the kernel has no usable console, so a
# plain OpenWrt boot is silent and unreachable. This script does the minimum
# needed to get an SSH shell:
#   * mount the pseudo filesystems
#   * remount / read-write (vendor bootargs use "ro")
#   * put 192.168.1.1/24 on mii0 -- the LAN port. Never touch eth0: opening it
#     kills the vendor kernel and the board then reboots in a loop.
#   * start dropbear with -R so host keys are generated on the fly
#   * keep PID 1 alive forever (exiting would panic the kernel)

PATH=/sbin:/bin:/usr/sbin:/usr/bin

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /tmp /var /var/run /var/log /root /etc/dropbear
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /run 2>/dev/null
mount -t tmpfs tmpfs /var/run 2>/dev/null

# root is jffs2 mounted read-only by the vendor cmdline; dropbear needs to
# write host keys, so make it writable.
mount -o remount,rw / 2>/dev/null

# --- LAN ---
LAN=""
for c in mii0 mii1 mii2; do
	[ -e "/sys/class/net/$c" ] && LAN="$c" && break
done

if [ -n "$LAN" ]; then
	ip link set "$LAN" up 2>/dev/null || ifconfig "$LAN" up 2>/dev/null
	ifconfig "$LAN" 192.168.1.1 netmask 255.255.255.0 up 2>/dev/null
	ip addr add 192.168.1.1/24 dev "$LAN" 2>/dev/null
	echo "init: LAN=$LAN up" >> /tmp/boot.log
else
	ls /sys/class/net >> /tmp/boot.log 2>/dev/null
fi

# --- ssh ---
/usr/sbin/dropbear -R -p 22 -P /tmp/dropbear.pid >> /tmp/boot.log 2>&1
sleep 1
if [ -f /tmp/dropbear.pid ]; then
	echo "init: dropbear up" >> /tmp/boot.log
fi

# --- keep PID 1 alive; a real init can be started later over ssh ---
exec /bin/sleep 100000000
