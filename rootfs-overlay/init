#!/bin/sh
# Bring-up init v11 = exact v8 baseline for the ZTE F673AV9a
# (vendor 4.19 kernel, no console).
#
# Why: the v9 series proved ANY insmod panics this kernel (even tun.ko).
# v8 (no modules at all) was stable. Before adding modules back in
# minimal steps, re-establish the known-good baseline and VERIFY the
# network stack end-to-end from the PC: telnet 192.168.1.1 must give
# a shell. No difference from v8 except comments/label [V11].
#
# HARD RULE: this init must NEVER write to NAND.
#
# v8/v11:
#   * root stays mounted READ-ONLY, all temporary state in tmpfs (/tmp)
#   * no dropbear (its key handling may write); telnetd only
#   * diagnostics go to PHYSICAL RAM markers via /dev/mem at four fixed
#     addresses, followed by `reboot -f` (warm reset keeps DRAM) so u-boot
#     can be intercepted and the markers read back:
#       md.b 0x4c000000 0x200 ; md.b 0x4e000000 0x200
#       md.b 0x56000000 0x200 ; md.b 0x57000000 0x200
#   * brings up every netdev (staggered 2s), pings the host after each
#   * if any interface reaches operstate=up, stays alive (telnet 192.168.1.1)
#     otherwise warm-reboots after 60s so markers can be collected

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

# decimal seek units (512B) for dd on /dev/mem: 0x4C000000/512 etc.
RM_SEEKS="2490368 2555904 2818048 2852144"

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /tmp /var /var/run /var/log /root 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /var/run 2>/dev/null

# best-effort uart beacon (kernel has no usable console; harmless)
for t in /dev/ttyS0 /dev/ttyAMA0 /dev/ttyS1 /dev/ttyPS0; do
	[ -c "$t" ] || continue
	stty -F "$t" 115200 raw -echo 2>/dev/null
	if printf '\r\n[V11] alive on %s\r\n' "$t" > "$t" 2>/dev/null; then
		UART="$t"
		break
	fi
done

[ -e /dev/mem ] || mknod /dev/mem c 1 1 2>/dev/null
MEM_OK=no
[ -e /dev/mem ] && [ -c /dev/mem ] && MEM_OK=yes

mark() {
	printf '[V11] %s\n' "$1" > /tmp/m 2>/dev/null
	if [ "$MEM_OK" = "yes" ]; then
		for sk in $RM_SEEKS; do
			dd if=/tmp/m of=/dev/mem bs=512 seek=$sk conv=notrunc 2>/dev/null
		done
	fi
	[ -n "$UART" ] && printf '[V11] %s\r\n' "$1" > "$UART" 2>/dev/null
}

mark "start mem=$MEM_OK net=$(ls /sys/class/net 2>/dev/null | tr '\n' ',')"
mark "mtd $(cut -d' ' -f1,3,4 /proc/mtd 2>/dev/null | tr '\n' '|')"

ip link set lo up 2>/dev/null

for n in /sys/class/net/*; do
	d=${n##*/}
	[ "$d" = "lo" ] && continue
	mark "PRE $d"
	ip link set "$d" up 2>/dev/null || ifconfig "$d" up 2>/dev/null
	sleep 2
	mark "UP $d st=$(cat /sys/class/net/$d/operstate 2>/dev/null)"
	ifconfig "$d" 192.168.1.1 netmask 255.255.255.0 2>/dev/null ||
		ip addr add 192.168.1.1/24 dev "$d" 2>/dev/null
	# external signal: ARP/ping towards the host, PC side is watching
	ping -c 2 -W 2 192.168.1.254 >/dev/null 2>&1 && mark "PING-OK $d"
	sleep 1
done

telnetd -l /bin/sh -p 23 >/dev/null 2>&1 &
mark "telnetd 23 up"

LINKED=""
i=0
while [ $i -lt 30 ]; do
	for n in /sys/class/net/*; do
		d=${n##*/}
		[ "$d" = "lo" ] && continue
		[ "$(cat /sys/class/net/$d/operstate 2>/dev/null)" = "up" ] && LINKED="$LINKED $d"
	done
	[ -n "$LINKED" ] && break
	sleep 3
	i=$((i + 1))
done
mark "LINKED=$LINKED"

if [ -n "$LINKED" ]; then
	# someone can reach us: stay alive (telnet 192.168.1.1)
	exec sleep 100000000
fi

mark "no link - warm reboot in 5s so u-boot can dump RAM markers"
sleep 5
reboot -f
exec sleep 100000000
