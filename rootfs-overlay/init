#!/bin/sh
# Bring-up init v21 for the ZTE F673AV9a (vendor 4.19 kernel, no console).
#
# v20 board-test results (2026-11-27, via __log_buf mining of initbin v9):
#   * initbin v9 PROVEN: alive t=0s/t=120s, wdt_path=2 proc feed OK,
#     diag reboot at 150s -> warm reset, DRAM ring intact. Toolchain closed.
#   * /init DIED AT LINE 40: "exec 3>/dev/watchdog" - POSIX rule: in a
#     non-interactive shell, `exec` with a FAILING redirection EXITS the
#     whole shell. Ring showed only "/init: line 40: can't create
#     /dev/watchdog: No such device" then silence. Not ratelimit (0
#     suppressed messages) - v19 died the same way.
#
# v21 changes vs v20:
#   * NO exec-with-device-redirect ANYWHERE (only `exec 2>/dev/kmsg`,
#     guarded by [ -c /dev/kmsg ], which works - initbin pre-creates it)
#   * watchdog: per-feed single write `printf 'F' > /dev/watchdog`
#     (a failing command redirect only kills the command, not the shell)
#   * mounts moved BEFORE first feed so the /proc/watchdog/ctrl fallback
#     path is available immediately
#   * klog spacing 1s kept (devkmsg budget 10 msgs/5s)
#   * HARD RULE unchanged: never write NAND, keep root read-only

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

# ---------- kmsg channel first (initbin already created /dev/kmsg) ----------
[ -e /dev/kmsg ] || mknod /dev/kmsg c 1 11 2>/dev/null
[ -c /dev/kmsg ] && exec 2>/dev/kmsg

klog() {
	printf '[V21] %s\n' "$1" > /dev/kmsg 2>/dev/null
	printf '[V21] %s\n' "$1" > /tmp/v21.log 2>/dev/null
	sleep 1
}

# ---------- mounts FIRST (feed fallback needs /proc) ----------
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /tmp /var /var/run /var/log /root 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /var/run 2>/dev/null

# ---------- watchdog: per-feed single writes, no fd keeping ----------
WOPEN=no
WDNODE=no
[ -e /dev/watchdog ] || mknod /dev/watchdog c 10 130 2>/dev/null
[ -c /dev/watchdog ] && WDNODE=yes

feed() {
	if [ "$WDNODE" = "yes" ] && printf 'F' > /dev/watchdog 2>/dev/null; then
		return 0
	fi
	printf 'feeddog' > /proc/watchdog/ctrl 2>/dev/null && return 0
	printf 'feeddog' > /proc/watchdog 2>/dev/null && return 0
	return 1
}

# probe which path works (result logged, not relied upon)
WDPATH=none
if [ "$WDNODE" = "yes" ] && printf 'F' > /dev/watchdog 2>/dev/null; then
	WDPATH=node
elif printf 'feeddog' > /proc/watchdog/ctrl 2>/dev/null; then
	WDPATH=proc_ctrl
elif printf 'feeddog' > /proc/watchdog 2>/dev/null; then
	WDPATH=proc_root
fi
klog "watchdog probe path=$WDPATH wdnodesys=$WDNODE"

# background feeder: survives even if main flow stalls
(
	while :; do
		feed 2>/dev/null
		sleep 3
	done
) &

klog "mounts done mtd=$(cut -d' ' -f1,3,4 /proc/mtd 2>/dev/null | tr '\n' '|')"

# best-effort uart beacon (kernel has no usable console; harmless)
for t in /dev/ttyS0 /dev/ttyAMA0 /dev/ttyS1 /dev/ttyPS0; do
	[ -c "$t" ] || continue
	stty -F "$t" 115200 raw -echo 2>/dev/null
	if printf '\r\n[V21] alive on %s\r\n' "$t" > "$t" 2>/dev/null; then
		UART="$t"
		break
	fi
done

klog "start net=$(ls /sys/class/net 2>/dev/null | tr '\n' ',')"

ip link set lo up 2>/dev/null

for n in /sys/class/net/*; do
	d=${n##*/}
	[ "$d" = "lo" ] && continue
	klog "PRE $d"
	ip link set "$d" up 2>/dev/null || ifconfig "$d" up 2>/dev/null
	sleep 2
	klog "UP $d st=$(cat /sys/class/net/$d/operstate 2>/dev/null)"
	ifconfig "$d" 192.168.1.1 netmask 255.255.255.0 2>/dev/null ||
		ip addr add 192.168.1.1/24 dev "$d" 2>/dev/null
	ping -c 2 -W 2 192.168.1.254 >/dev/null 2>&1 && klog "PING-OK $d"
done

# ---------- remote access attempts (stderr already -> kmsg) ----------
telnetd -l /bin/sh -p 23 >/dev/null 2>&1 &
klog "telnetd attempted (applet may be missing)"

/usr/sbin/netshell >/dev/null 2>&1 &
klog "netshell attempted on :23"

mkdir -p /etc/dropbear 2>/dev/null
dropbear -F -E -p 22 >/dev/null 2>&1 &
klog "dropbear attempted on :22"

# ---------- liveness loop: PID1 NEVER exits ----------
LINKED=""
i=0
while :; do
	for n in /sys/class/net/*; do
		d=${n##*/}
		[ "$d" = "lo" ] && continue
		[ "$(cat /sys/class/net/$d/operstate 2>/dev/null)" = "up" ] &&
			LINKED="$LINKED $d"
	done
	feed 2>/dev/null || klog "watchdog feed FAILED in main loop"
	if [ $((i % 10)) -eq 0 ]; then
		klog "alive t=$((i * 3))s linked=[$LINKED] up=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)"
	fi
	i=$((i + 1))
	sleep 3
done
