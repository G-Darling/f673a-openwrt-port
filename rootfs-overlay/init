#!/bin/sh
# Bring-up init v26 for the ZTE F673AV9a (vendor 4.19 kernel, no console).
#
# v25 board-test results (2026-11-28, ram ring mining):
#   * UBIFS MOUNTED at /tmp/a: ubiattach mtd9 rc=0 (400 LEBs, 48.4MiB),
#     volume ubi0_0 name=osgi_ubifs -> mount OK (kernel confirmed).
#   * volume top holds ONE file: osgi.img  (vendor fs: kos=0 kmi=[]
#     top=osgi.img). All vendor .kos are packed inside osgi.img, which
#     the vendor system loop-mounts (kernel strings: "mount loop0").
#   * kernel log shows "zte open kmodule.img failed!" - vendor boot
#     mechanism itself looked for kmodule.img and missed it.
#   * after-insmod net unchanged => ethernet still needs vendor .kos.
#
# v26 changes vs v25:
#   * NEW: loop-mount osgi.img layer (/tmp/b) when volume top has *.img
#     - try squashfs/cramfs/jffs2/romfs/ext2/ext4/vfat
#     - ALWAYS log its first magic bytes (hex) so we learn the format
#       even if every mount fails
#   * loop device nodes ensured (mknod b 7 N fallback, devtmpfs covers it
#     when CONFIG_BLK_DEV_LOOP=y)
#   * re-scan kos/kmi inside /tmp/b; kmodule.img then loop-mounts to
#     /tmp/kmod as before; insmod paths extended to /tmp/b
#   * HARD RULE unchanged: never write NAND, keep root read-only

PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH

# ---------- kmsg channel first (initbin already created /dev/kmsg) ----------
[ -e /dev/kmsg ] || mknod /dev/kmsg c 1 11 2>/dev/null
[ -c /dev/kmsg ] && exec 2>/dev/kmsg

klog() {
	printf '[V26] %s\n' "$1" > /dev/kmsg 2>/dev/null
	printf '[V26] %s\n' "$1" > /tmp/v23.log 2>/dev/null
	sleep 1
}

# ---------- mounts FIRST (feed fallback needs /proc) ----------
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /tmp /var /var/run /var/log /root 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /var/run 2>/dev/null

# loop devices: devtmpfs provides them if CONFIG_BLK_DEV_LOOP=y;
# mknod fallback covers the static-node case (b 7 0..3)
for i in 0 1 2 3; do
	[ -e /dev/loop$i ] || mknod /dev/loop$i b 7 $i 2>/dev/null
done

# ---------- watchdog: per-feed single writes ----------
WDNODE=no
[ -e /dev/watchdog ] || mknod /dev/watchdog c 10 130 2>/dev/null
[ -c /dev/watchdog ] && WDNODE=yes

feed() {
	if [ "$WDNODE" = "yes" ] && printf 'F' > /dev/watchdog 2>/dev/null; then
		return 0
	fi
	printf 'feeddog' > /proc/watchdog/ctrl 2>/dev/null && return 0
	printf 'feeddog' > /proc/watchdog 2>/dev/null && return 0
	return 1
}

WDPATH=none
if [ "$WDNODE" = "yes" ] && printf 'F' > /dev/watchdog 2>/dev/null; then
	WDPATH=node
elif printf 'feeddog' > /proc/watchdog/ctrl 2>/dev/null; then
	WDPATH=proc_ctrl
elif printf 'feeddog' > /proc/watchdog 2>/dev/null; then
	WDPATH=proc_root
fi
klog "watchdog probe path=$WDPATH"

# background feeder: survives even if main flow stalls
(
	while :; do
		feed 2>/dev/null
		sleep 3
	done
) &

mkdir -p /tmp/a /tmp/kmod /tmp/b  # /tmp is tmpfs - / is READ-ONLY jffs2!

# ---------- UBI attach + UBIFS mount (vendor rootfs hunt) ----------
[ -e /dev/ubi_ctrl ] || mknod /dev/ubi_ctrl c 10 62 2>/dev/null
[ -e /dev/mtd9 ] || mknod /dev/mtd9 c 90 18 2>/dev/null
[ -e /dev/mtd10 ] || mknod /dev/mtd10 c 90 20 2>/dev/null

MTD=9
ubiattach -m 9 /dev/ubi_ctrl > /tmp/ua 2>&1
rc=$?
if [ "$rc" != "0" ]; then
	MTD=10
	ubiattach -m 10 /dev/ubi_ctrl > /tmp/ua 2>&1
	rc=$?
fi
klog "ubiattach mtd$MTD rc=$rc out=$(tr '\n' ';' < /tmp/ua | head -c 90)"

VOLS=$(ls /sys/class/ubi 2>/dev/null)
VCNT=$(cat /sys/class/ubi/ubi0/volumes_count 2>/dev/null)
UBIFS_OK=$(grep -c ubifs /proc/filesystems 2>/dev/null)
klog "ubi sysfs=[$VOLS] vcnt=$VCNT ubifs-in-kernel=$UBIFS_OK"

UMNT=""
# volume dirs live at TOP level: /sys/class/ubi/ubi0_0 etc (v22 bug here)
# NOTE: mount stderr goes to kmsg (no 2>/dev/null) so failure reason lands
# in the ring - v34 failed blind.
for d in $(ls -d /sys/class/ubi/ubi0_* 2>/dev/null); do
	v=${d##*/}
	vn=$(cat $d/name 2>/dev/null)
	vtype=$(cat $d/type 2>/dev/null)
	klog "vol $v name=[$vn] type=$vtype"
	mount -t ubifs "$v" /tmp/a && UMNT="$v($vn)" && break
	klog "mount $v rc=$? - trying ro"
	mount -t ubifs -o ro "$v" /tmp/a && UMNT="$v($vn,ro)" && break
	if [ -n "$vn" ]; then
		mount -t ubifs "ubi0:$vn" /tmp/a && UMNT="$v($vn,byname)" && break
	fi
done
klog "ubifs mount=[$UMNT] mntlist=$(grep -E 'ubi|ubifs' /proc/mounts | tr '\n' ';' | head -c 80)"

KOS=0
KMI=""
if [ -n "$UMNT" ]; then
	KMI=$(find /tmp/a -maxdepth 4 -name 'kmodule*.img' 2>/dev/null | head -1)
	KOS=$(find /tmp/a -name '*.ko' 2>/dev/null | wc -l)
	klog "vendor fs: kos=$KOS kmi=[$KMI] top=$(ls /tmp/a 2>/dev/null | tr '\n' ',' | head -c 90)"
fi

# ---------- osgi.img layer (v26) ----------
# v25 proved the volume top holds one file: osgi.img. The vendor system
# loop-mounts packed images (kernel string "mount loop0"). Try every
# plausible fs; log magic bytes FIRST so the format is known even if
# all mounts fail.
OSGI=$(ls /tmp/a/*.img 2>/dev/null | head -1)
OB=0
if [ "$KOS" = "0" ] && [ -n "$OSGI" ]; then
	klog "osgi magic=$(dd if="$OSGI" bs=16 count=1 2>/dev/null | od -An -tx1 | tr -s ' \n' ' ')"
	if mount -o loop -t squashfs "$OSGI" /tmp/b 2>/dev/null; then OB=1
	elif mount -o loop -t cramfs "$OSGI" /tmp/b 2>/dev/null; then OB=1
	elif mount -o loop -t jffs2 "$OSGI" /tmp/b 2>/dev/null; then OB=1
	elif mount -o loop -t romfs "$OSGI" /tmp/b 2>/dev/null; then OB=1
	elif mount -o loop -t ext2 "$OSGI" /tmp/b 2>/dev/null; then OB=1
	elif mount -o loop -t ext4 "$OSGI" /tmp/b 2>/dev/null; then OB=1
	elif mount -o loop -t vfat "$OSGI" /tmp/b 2>/dev/null; then OB=1
	fi
	klog "osgi loop rc=$OB mntlist=$(grep -E '/tmp/b' /proc/mounts | tr '\n' ';' | head -c 60)"
	KMI=$(find /tmp/b -maxdepth 4 -name 'kmodule*.img' 2>/dev/null | head -1)
	KOS=$(find /tmp/b -name '*.ko' 2>/dev/null | wc -l)
	klog "osgi layer: kos=$KOS kmi=[$KMI] top=$(ls /tmp/b 2>/dev/null | tr '\n' ',' | head -c 120)"
fi

# kmodule.img loop-mount fallback if no loose .ko found
KMNTED=0
if [ "$KOS" = "0" ] && [ -n "$KMI" ]; then
	if mount -o loop -t squashfs "$KMI" /tmp/kmod 2>/dev/null; then
		KMNTED=1
	elif mount -o loop -t cramfs "$KMI" /tmp/kmod 2>/dev/null; then
		KMNTED=1
	elif mount -o loop -t jffs2 "$KMI" /tmp/kmod 2>/dev/null; then
		KMNTED=1
	elif mount -o loop -t romfs "$KMI" /tmp/kmod 2>/dev/null; then
		KMNTED=1
	fi
	KOS=$(find /tmp/kmod -name '*.ko' 2>/dev/null | wc -l)
	klog "kmi loop rc=$KMNTED kos=$KOS"
fi

# ---------- insmod all vendor modules (two passes for dep order) ----------
if [ "$KOS" != "0" ]; then
	for pass in 1 2; do
		FAILS=""
		for f in $(find /tmp/a /tmp/b /tmp/kmod -name '*.ko' 2>/dev/null); do
			insmod "$f" 2>/dev/null || FAILS="$FAILS ${f##*/}"
		done
	done
	klog "insmod fails=[$FAILS]"
fi

klog "after-insmod net=$(ls /sys/class/net 2>/dev/null | tr '\n' ',')"

# ---------- bring up whatever appeared ----------
ip link set lo up 2>/dev/null
for n in /sys/class/net/*; do
	d=${n##*/}
	[ "$d" = "lo" ] && continue
	klog "PRE $d"
	ip link set "$d" up 2>/dev/null || ifconfig "$d" up 2>/dev/null
	sleep 2
	klog "UP $d st=$(cat /sys/class/net/$d/operstate 2>/dev/null)"
	ifconfig "$d" 192.168.1.1 netmask 255.255.255.0 2>/dev/null ||
		ip addr add 192.168.1.1/24 dev "$d" 2>/dev/null
	ping -c 2 -W 2 192.168.1.254 >/dev/null 2>&1 && klog "PING-OK $d"
done

# ---------- remote access attempts (stderr already -> kmsg) ----------
mkdir -p /etc/dropbear 2>/dev/null
[ -e /etc/dropbear/dropbear_rsa_host_key ] ||
	dropbearkey -t rsa -f /etc/dropbear/dropbear_rsa_host_key >/dev/null 2>&1
dropbear -F -E -p 22 >/dev/null 2>&1 &
klog "dropbear attempted on :22"

/usr/sbin/netshell >/dev/null 2>&1 &
klog "netshell attempted on :23"

# ---------- liveness loop: PID1 NEVER exits ----------
LINKED=""
i=0
while :; do
	for n in /sys/class/net/*; do
		d=${n##*/}
		[ "$d" = "lo" ] && continue
		[ "$(cat /sys/class/net/$d/operstate 2>/dev/null)" = "up" ] &&
			LINKED="$LINKED $d"
	done
	feed 2>/dev/null || klog "watchdog feed FAILED in main loop"
	if [ $((i % 10)) -eq 0 ]; then
		klog "alive t=$((i * 3))s linked=[$LINKED] up=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)"
	fi
	i=$((i + 1))
	sleep 3
done
