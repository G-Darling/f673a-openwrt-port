#!/bin/sh
# Bring-up init v20 for the ZTE F673AV9a (vendor 4.19 kernel, no console).
#
# v19 board-test results (2026-11-27, via __log_buf mining of initbin v8):
#   * /sbin/init (static initbin) + spawn /bin/sh /init: PROVEN WORKING.
#     Ring showed: mount proc=0 dev=0 mknod=0 kmsg=3F, sysfs rc=0,
#     /dev/watchdog open=-19 (ENODEV, fallback proc feed works, wdt_path=2),
#     spawned /init pid=712, diag reboot at 60s -> warm reset, DRAM intact.
#   * /init DID run (set -x traces visible) but ALL its /dev/kmsg output
#     was eaten by the kernel devkmsg ratelimiter:
#     "sh: 9 output lines suppressed due to ratelimiting"
#     => set -x floods /dev/kmsg far beyond the 10-msg-per-5s budget.
#   * vendor driver spams "get_items failed" every ~2s (thermal/wdt proc
#     poller) - pollutes the ring but does not consume our kmsg budget.
#
# v20 changes vs v19:
#   * NO set -x (that was the ratelimit killer)
#   * klog() sleeps 1s after each write => max ~5 msgs/5s, safely under
#     the 10-msgs/5s devkmsg burst limit
#   * dropped the useless /dev/mem raw-marker writes (devmem was strict)
#   * fewer, higher-value klogs; alive loop logs every 30s
#   * HARD RULE unchanged: never write NAND, keep root read-only

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

# ---------- early: kmsg channel + watchdog, before anything else ----------
[ -e /dev/kmsg ] || mknod /dev/kmsg c 1 11 2>/dev/null
[ -c /dev/kmsg ] && exec 2>/dev/kmsg

klog() {
	printf '[V20] %s\n' "$1" > /dev/kmsg 2>/dev/null
	printf '[V20] %s\n' "$1" > /tmp/v20.log 2>/dev/null
	sleep 1
}

[ -e /dev/watchdog ] || mknod /dev/watchdog c 10 130 2>/dev/null
WOPEN=no
if [ -c /dev/watchdog ]; then
	exec 3>/dev/watchdog 2>/dev/null && WOPEN=yes
fi

feed() {
	if [ "$WOPEN" = "yes" ]; then
		printf 'F' >&3 2>/dev/null && return 0
	fi
	printf 'F' > /dev/watchdog 2>/dev/null && return 0
	printf 'feeddog' > /proc/watchdog/ctrl 2>/dev/null && return 0
	printf 'feeddog' > /proc/watchdog 2>/dev/null && return 0
	return 1
}

feed && klog "watchdog fed ok (wopen=$WOPEN)" || klog "watchdog feed FAILED first try"

# background feeder: survives even if main flow stalls
(
	while :; do
		feed 2>/dev/null
		sleep 3
	done
) &

# ---------- mounts (same as v8/v19) ----------
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /tmp /var /var/run /var/log /root 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /var/run 2>/dev/null

# best-effort uart beacon (kernel has no usable console; harmless)
for t in /dev/ttyS0 /dev/ttyAMA0 /dev/ttyS1 /dev/ttyPS0; do
	[ -c "$t" ] || continue
	stty -F "$t" 115200 raw -echo 2>/dev/null
	if printf '\r\n[V20] alive on %s\r\n' "$t" > "$t" 2>/dev/null; then
		UART="$t"
		break
	fi
done

klog "start net=$(ls /sys/class/net 2>/dev/null | tr '\n' ',')"
klog "mtd $(cut -d' ' -f1,3,4 /proc/mtd 2>/dev/null | tr '\n' '|')"

ip link set lo up 2>/dev/null

for n in /sys/class/net/*; do
	d=${n##*/}
	[ "$d" = "lo" ] && continue
	klog "PRE $d"
	ip link set "$d" up 2>/dev/null || ifconfig "$d" up 2>/dev/null
	sleep 2
	klog "UP $d st=$(cat /sys/class/net/$d/operstate 2>/dev/null)"
	ifconfig "$d" 192.168.1.1 netmask 255.255.255.0 2>/dev/null ||
		ip addr add 192.168.1.1/24 dev "$d" 2>/dev/null
	ping -c 2 -W 2 192.168.1.254 >/dev/null 2>&1 && klog "PING-OK $d"
done

# ---------- remote access attempts (stderr already -> kmsg) ----------
telnetd -l /bin/sh -p 23 >/dev/null 2>&1 &
klog "telnetd attempted (applet may be missing)"

/usr/sbin/netshell >/dev/null 2>&1 &
klog "netshell attempted on :23"

mkdir -p /etc/dropbear 2>/dev/null
dropbear -F -E -p 22 >/dev/null 2>&1 &
klog "dropbear attempted on :22"

# ---------- liveness loop: PID1 NEVER exits ----------
LINKED=""
i=0
while :; do
	for n in /sys/class/net/*; do
		d=${n##*/}
		[ "$d" = "lo" ] && continue
		[ "$(cat /sys/class/net/$d/operstate 2>/dev/null)" = "up" ] &&
			LINKED="$LINKED $d"
	done
	feed 2>/dev/null || klog "watchdog feed FAILED in main loop"
	if [ $((i % 10)) -eq 0 ]; then
		klog "alive t=$((i * 3))s linked=[$LINKED] up=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)"
	fi
	i=$((i + 1))
	sleep 3
done
