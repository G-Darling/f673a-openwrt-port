#!/bin/sh
# Bring-up init v9 for the ZTE F673AV9a (vendor 4.19.136 kernel, no console).
#
# BREAKTHROUGH since v8: the LAN MAC/PHY drivers are NOT built into the
# vendor kernel. They live in /kmoduletmp/kmodule.img (a squashfs the kernel
# loop-mounts onto /kmodule at boot). We extracted the modules from the
# vendor image and bake them into our rootfs at /kmodule/*.ko instead.
#
# Load order mirrors vendor S43BSPDriver + S99modules:
#   bspdriver -> tm_128s -> netdriver -> switch
# (switch depends on tm_128s; netdriver needs the MAC/PHY registered.)
#
# HARD RULE kept from v8: NEVER write to NAND (v3/5/6/7 reset loops proved
# any real write panics this kernel). Everything goes to tmpfs; root stays ro.
# Diagnostics: if no netdev appears we warm-reboot so the PC-side serial
# monitor can time the cycles; if a netdev appears we stay alive with telnetd.

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /tmp /var /var/run /var/log /root 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /var/run 2>/dev/null

: > /tmp/boot.log

for m in patch shellproc bspdriver netdriver; do
	if /sbin/insmod /kmodule/$m.ko 2>>/tmp/boot.log; then
		echo "[V9] insmod $m OK" >> /tmp/boot.log
	else
		echo "[V9] insmod $m FAILED" >> /tmp/boot.log
	fi
	sleep 1
done

# wait up to 20s for netdevs from netdriver
i=0
while [ $i -lt 20 ]; do
	N=$(ls /sys/class/net 2>/dev/null | grep -v lo)
	[ -n "$N" ] && break
	sleep 1
	i=$((i + 1))
done
echo "[V9] netdevs after ${i}s: $(ls /sys/class/net 2>/dev/null | tr '\n' ',')" >> /tmp/boot.log

ip link set lo up 2>/dev/null
for n in /sys/class/net/*; do
	d=${n##*/}
	[ "$d" = "lo" ] && continue
	ip link set "$d" up 2>/dev/null || ifconfig "$d" up 2>/dev/null
	sleep 2
	ifconfig "$d" 192.168.1.1 netmask 255.255.255.0 2>/dev/null ||
		ip addr add 192.168.1.1/24 dev "$d" 2>/dev/null
	ping -c 2 -W 2 192.168.1.254 >/dev/null 2>&1 &&
		echo "[V9] PING-OK via $d" >> /tmp/boot.log
	echo "[V9] up $d st=$(cat /sys/class/net/$d/operstate 2>/dev/null)" >> /tmp/boot.log
done

telnetd -l /bin/sh -p 23 >/dev/null 2>&1 &
echo "[V9] telnetd up" >> /tmp/boot.log

# stay alive forever - if the PC got a link, telnet 192.168.1.1 works;
# otherwise power-cycle for the next experiment (no marker channel exists)
exec sleep 100000000
