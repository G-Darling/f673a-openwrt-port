# OpenWrt userspace-only build for ZTE F673AV9a (ZX279128S, dual Cortex-A9)
#
# Route A: keep vendor kernel, boot OpenWrt userspace via u-boot bootargs.
#
# CRITICAL: the vendor kernel has NO VFP support compiled in
#   (no "VFP support v0.3", no NWFPE, no FPU strings in the decompressed vmlinux)
# and every vendor binary is soft-float EABI5 (ELF flags 0x05000200).
# Therefore our userspace MUST be soft-float. Target mvebu/cortexa9 yields
# arm_cortex-a9_vfpv3-d16 (HARD-FLOAT); its /sbin/init dies instantly with
# SIGILL -> "Attempted to kill init!" -> panic -> watchdog reset, which is
# exactly the 5-7 s reset loop we observed.
# bcm53xx is ARCH=arm, CPU_TYPE:=cortex-a9 with NO CPU_SUBTYPE
# => arch "arm_cortex-a9" = soft-float ARMv7.
# Target is used for toolchain/ABI only; no device image is flashed.

CONFIG_TARGET_bcm53xx=y
CONFIG_TARGET_bcm53xx_generic=y
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# --- minimal userspace set (no kernel modules: vendor kernel is used) ---
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_libuci=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y

# No firewall/NAT during first bring-up: firewall4+nftables pull kmod-nft-*,
# which would build a kernel we cannot load anyway. Enable later from inside.
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_nftables is not set
# CONFIG_PACKAGE_kmod-ipt-conntrack is not set

# WiFi: vendor driver is proprietary; do NOT build wireless stack for now
# CONFIG_PACKAGE_hostapd is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_iw is not set
